# ---------- Server ----------
# Shared state, for running more than one instance: sessions, rate limits,
# the SSE event bus and catalogue changes. Leave empty for a single
# instance or local development, and it all falls back to memory.
REDIS_URL=

PORT=8787
NODE_ENV=development
# Comma separated origins allowed to call the API (the widget's host page)
CORS_ORIGINS=http://localhost:5173

# ---------- Shopify catalog (UCP) ----------
# Store domain only, no protocol. Endpoint is https://<domain>/api/ucp/mcp
SHOPIFY_STORE_DOMAIN=druids-store.myshopify.com
# Buyer context, so prices come back localised (optional)
SHOPIFY_BUYER_COUNTRY=
SHOPIFY_BUYER_CURRENCY=
# Only recommend products carrying this tag. The test store also holds a
# generic demo catalogue that is not Druids kit. Leave empty on a real store.
# The basket goes over the Storefront API, which Shopify does NOT rate-limit
# for buyer traffic. The UCP endpoint is throttled hard enough to take the
# basket down for the best part of an hour, so set this before real traffic.
# Create it in the admin: Settings -> Apps and sales channels -> Develop apps
# -> your app -> Configuration -> Storefront API, then Install.
SHOPIFY_STOREFRONT_TOKEN=

# How often the local catalogue mirror refreshes, in ms. Shopify sees this
# many calls no matter how many customers are shopping.
SHOPIFY_CATALOGUE_REFRESH_MS=300000

SHOPIFY_BRAND_TAG=

# Where Shopify reads our UCP agent profile. It must be publicly reachable
# AND cacheable - a VS Code dev tunnel injects a no-store header that
# Shopify rejects, so in dev publish it to the Shopify CDN instead:
#   npm run publish:profile --workspace=@caddie/server
# In production, leave this empty and let CADDIE_PUBLIC_URL serve it.
UCP_AGENT_PROFILE_URL=

# Public URL of this server (a VS Code forwarded port or ngrok in dev).
# Vapi posts tool calls here.
CADDIE_PUBLIC_URL=

# ---------- OpenAI (text chat) ----------
# With this set, text chat runs a real tool-calling loop in our own
# process. Without it, chat falls back to Vapi, then to a keyword router.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Speech to text for the widget mic (POST /api/voice), until Vapi takes over.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Leave empty: the language is detected, then checked against the customer's
# page, browser and conversation, and re-heard if it lands in the wrong script.
# Set an ISO-639-1 code (e.g. en) only to force one language for every clip.
OPENAI_TRANSCRIBE_LANGUAGE=
# Screens the first message of a conversation for abuse and off-topic use,
# before the expensive loop. One word in, one word out - use the cheapest.
OPENAI_GUARD_MODEL=gpt-4.1-nano
# Model calls allowed at once. Past this they queue here rather than
# becoming a wall of 429s at the provider.
OPENAI_MAX_CONCURRENT=25
OPENAI_TIMEOUT_MS=45000

# ---------- Usage dashboard ----------
# Opens /admin, which shows OpenAI spend, which conversations caused it, and
# what was said in them. Unset, the route 404s and there is no dashboard.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Also salts the client labels on that screen, so every instance must share it.
ADMIN_TOKEN=

# ---------- Vapi (voice) ----------
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
# Shared secret we verify on the tool webhook (set the same value in Vapi headers)
VAPI_WEBHOOK_SECRET=

# ---------- Widget (build-time, must be prefixed VITE_) ----------
VITE_CADDIE_API_URL=http://localhost:8787
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
