{%- comment -%}
  Smart Cart: the SupaEasy deal key for this product, as a hidden line item
  property inside an add-to-cart form. Render it inside {% form 'product' %}:

    {% render 'smart-cart-deal-key', product: product %}

  The rules are the Caddie's (apps/server/src/smartCart/config.ts), so a
  product gets the same key whether the theme or the Caddie adds it:

    men's polos      tag bundle_threepolo        __3_Polo_Bundle = 3_Polo_Bundle
    kids polos       tag bundle_threepolo_kids   __bundle_threepolo_kids = bundle_threepolo_kids
    ladies polos     tag bundle_threepolo_ladies __bundle_threepolo_ladies = bundle_threepolo_ladies (the £59.99 deal)
    men's trousers   in men-golf-trousers        __any-2-trousers = any-2-trousers
    men's shorts     in men-golf-shorts          __any-2-trouser-shorts = any-2-trouser-shorts
    ladies trousers  in ladies-trousers, but not ladies-shorts
                                                 __ladies-any-2-trousers = ladies-any-2-trousers
    kids trousers    in kids-trousers            __kids-any-2-trousers = kids-any-2-trousers
    ladies shorts    in ladies-shorts            __any-2-shorts = ladies
    kids shorts      in kids-shorts              __any-2-shorts = kids

  On a product card, render it inside the card's opening tag instead, to
  carry the key as attributes for the card's own add-to-cart script:

    {% render 'smart-cart-deal-key', product: product, as: 'attributes' %}

  which prints data-deal-key="..." data-deal-value="...".

  A product that matches more than one deal gets no key: SupaEasy checks only
  the key, never the product, so a wrong key is a wrong price. Ladies shorts
  are merchandised into ladies-trousers as well; for those the shorts deal is
  the one meant, so ladies-trousers leaves out anything in ladies-shorts.
  Every fixed pack (Ambassador, Prestige, Players, Rainsuit...) is left out
  on purpose, as is the £55 ladies polo discount.
{%- endcomment -%}
{%- liquid
  assign sc_handles = product.collections | map: 'handle'
  assign sc_matches = 0
  assign sc_key = ''
  assign sc_value = ''

  if product.tags contains 'bundle_threepolo'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__3_Polo_Bundle'
    assign sc_value = '3_Polo_Bundle'
  endif
  if product.tags contains 'bundle_threepolo_kids'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__bundle_threepolo_kids'
    assign sc_value = 'bundle_threepolo_kids'
  endif
  if product.tags contains 'bundle_threepolo_ladies'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__bundle_threepolo_ladies'
    assign sc_value = 'bundle_threepolo_ladies'
  endif
  if sc_handles contains 'men-golf-trousers'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__any-2-trousers'
    assign sc_value = 'any-2-trousers'
  endif
  if sc_handles contains 'men-golf-shorts'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__any-2-trouser-shorts'
    assign sc_value = 'any-2-trouser-shorts'
  endif
  assign sc_ladies_short = false
  if sc_handles contains 'ladies-shorts'
    assign sc_ladies_short = true
  endif
  if sc_handles contains 'ladies-trousers' and sc_ladies_short == false
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__ladies-any-2-trousers'
    assign sc_value = 'ladies-any-2-trousers'
  endif
  if sc_handles contains 'kids-trousers'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__kids-any-2-trousers'
    assign sc_value = 'kids-any-2-trousers'
  endif
  if sc_handles contains 'ladies-shorts'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__any-2-shorts'
    assign sc_value = 'ladies'
  endif
  if sc_handles contains 'kids-shorts'
    assign sc_matches = sc_matches | plus: 1
    assign sc_key = '__any-2-shorts'
    assign sc_value = 'kids'
  endif
-%}
{%- if sc_matches == 1 -%}
  {%- if as == 'attributes' -%}
    data-deal-key="{{ sc_key }}" data-deal-value="{{ sc_value }}"
  {%- else -%}
    <input type="hidden" name="properties[{{ sc_key }}]" value="{{ sc_value }}">
  {%- endif -%}
{%- endif -%}
